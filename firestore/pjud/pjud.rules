rules_version = '2';

// Base `pjud`: scraper_casos y scraper_jobs (contrato con el scraper de PJUD).
// NINGÚN cliente la lee ni la escribe. Lens accede con credenciales de servidor
// (lens-flujo-autonomo y lens-pjud-lector) y el scraper con su propia cuenta de
// servicio, limitada por IAM a esta base. Las reglas no aplican a esos accesos.
//
// Estas reglas son SOLO de la base `pjud`: la base (default) de Lens tiene las
// suyas y este directorio no las toca (firebase.json lista solo `pjud`).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
